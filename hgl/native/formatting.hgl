module core part formatting

/**
Fill the places in a constant format string (FMT-1 to FMT-5).

Args:
    fmt_str: The format string whose places the compiler checks.
    args: Positional values in the order the places use them.
    kwargs: Named values, found by the written place names.

Returns:
    The text with each place filled.

Notes:
    See the [formatting reference](https://github.com/hhenson/hgl_core/blob/main/spec/formatting.md#reference).
*/
export operator format<...As, ...Ks>(
    const fmt_str: str, args: ...As, kwargs: ...{Ks}) -> str

/**
Format values immediately in value code (FMT-7, FMT-9).

Args:
    not_valid: Text for a Marked value that is absent. The default is "<not valid>".
    ticked: Prefix for a marked place whose value ticked. The default is "*".
    fmt_str: The constant format string.
    args: Values for positional places.
    kwargs: Values for named places.

Returns:
    The formatted text.

Notes:
    See the [formatting reference](https://github.com/hhenson/hgl_core/blob/main/spec/formatting.md#reference).
*/
native impl const fn format<...As, ...Ks>{
    const not_valid: str = "<not valid>",
    const ticked: str = "*",
}(const fmt_str: str, args: ...As, kwargs: ...{Ks}) -> str

/**
An optional formatting value and its tick flag (FMT-7, FMT-9).

Type Args:
    T: The type formatted when the value is present.

Notes:
    See the [formatting reference](https://github.com/hhenson/hgl_core/blob/main/spec/formatting.md#reference).
*/
export struct Marked<T> {
    /** The value, or null to use the not_valid option. */
    value: T?
    /** Whether a marked place writes the ticked prefix. */
    ticked: bool
}
