module core part graph_formatting

# An explicit require_valid selects this prototype for scalar input packs.
impl fn format<...As, ...Ks>{
    const require_valid: bool,
    const not_valid: str = "<not valid>",
    const ticked: str = "*",
}(const fmt_str: str, args: ...As, kwargs: ...{Ks}) -> str
    requires each k in arg_keys(As) { As[k] in {i64, f64, bool, str} }
          && each k in arg_keys(Ks) { Ks[k] in {i64, f64, bool, str} }
          && (any k in arg_keys(As) { k == k } || any k in arg_keys(Ks) { k == k })
{
    inject clock
    when valid([]) {
        # modified([]) is true when no input published in this cycle.
        if !modified([]) && (!require_valid || valid()) {
            return _format{not_valid: not_valid, ticked: ticked}(
                fmt_str, clock,
                ...{for k in arg_keys(As): Marked(
                    value: if valid(args[k]) { args[k] } else { null },
                    ticked: modified(args[k]))},
                ...{for k in arg_keys(Ks): Marked(
                    value: if valid(kwargs[k]) { kwargs[k] } else { null },
                    ticked: modified(kwargs[k]))})
        }
    }
}
