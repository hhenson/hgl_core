module core

# Core's mandatory module: every module binds its public declarations
# without a `use` (UNIT-11). Contracts: spec/numeric-operators.md,
# spec/scalar-operators.md, spec/capabilities.md,
# spec/temporal-endpoints.md, spec/list-operations.md,
# spec/tenor-operations.md and spec/execution.md. The native candidates
# are in hgl/native/scalar_operators.hgl, the capabilities in
# hgl/native/capabilities.hgl, the endpoint operations in
# hgl/native/endpoints.hgl, the list operations in hgl/native/lists.hgl
# and a tenor's in hgl/native/tenors.hgl. The calendar, the rolling rule
# and the candidates that move a date are in hgl/core/calendar.hgl.

# The outcome of a full comparison, `<=>` (OPS-3, NUM-6).
export enum CmpResult { less, equivalent, greater, unordered }

# What a division does with a zero divisor (NUM-3, NUM-9, NUM-12).
export enum ZeroPolicy { ieee, nan, error, fail }

# How an `f64` is rounded to an `i64` (OPS-8).
export enum Rounding { truncate, floor, ceiling, half_even, half_up, half_down }

# What a conversion does when it fails (OPS-8).
export enum InvalidPolicy { error, fail }

# Admission for same-type temporal addition/subtraction (OPS-9).
export enum InvalidInputPolicy { identity }

# The level of a log record (CAP-2).
export enum LogLevel { debug, info, warning, error }

# The named times of a run (CRUN-3). `smallest_step` is the least by which
# one cycle's evaluation time follows another's. `never` is before every
# evaluation time and `forever` after every one: no cycle runs at either.
# `earliest_start` is the first instant a run may start at, and
# `latest_end` the last it may end at.
export const smallest_step: duration = 1us
export const never: datetime = @1970-01-01T00:00:00Z
export const earliest_start: datetime = never + smallest_step
export const forever: datetime = @2262-04-11T00:00:00Z
export const latest_end: datetime = forever - smallest_step

# `log` at each level (CAP-2). The native `log` and the capability types
# are in hgl/native/capabilities.hgl.
export const fn log_debug(logger: Logger, message: str) {
    log(logger, .debug, message)
}

export const fn log_info(logger: Logger, message: str) {
    log(logger, .info, message)
}

export const fn log_warning(logger: Logger, message: str) {
    log(logger, .warning, message)
}

export const fn log_error(logger: Logger, message: str) {
    log(logger, .error, message)
}

# `replay` and `record` are a run's own (CEVAL-1, CRUN-8). They are not
# exported: a run wires them, and no module names them, so a program may
# use either name for a declaration of its own.

# The publications a replay list holds, each at its time (CEVAL-2,
# CEVAL-3). A window's are its arrivals; the window takes its values out
# itself (END-9). An eval's run wires one to each temporal input of its
# target (CEVAL-1).
fn replay<T>(const items: list<tuple<datetime, delta<T>>>) -> T {
    for item in items {
        yield item[0]: item[1]
    }
}

# Each publication of `input`, with its evaluation time, put in the store
# under `key` at stop (CEVAL-4). The delta is read into a `result`: a
# cycle in which a value only leaves a window of a duration has none, and
# adds no tuple (END-3, END-9). A run wires one to its entry's result
# under the run's key (CRUN-8).
fn record<T>(input: T, const key: str) {
    cache entries: list<tuple<datetime, delta<T>>> = []
    inject clock, global_state
    when valid(input) && modified(input) {
        let change: result<delta<T>, error> = delta_value(input)
        if is_ok(change) { append(entries, (clock.evaluation_time, change.value)) }
    }
    stop { put(global_state, key, entries) }
}

# Ask for a wake on a scheduler or an alarm (CAP-4, CAP-5). `at` is a
# `duration` from the current evaluation time, or a `datetime`.
export operator schedule<C, W>(capability: C, at: W)

# The global store (CAP-6): the value under a key, whether a key holds
# one, and a value put under a key. A call of `get` writes `V` and leaves
# the store and the key to be inferred, as `convert<T>(value)` does. `get`
# can fail, a dictionary's (the language's ERR-6) and the store's: it gives
# a `result<V, error>`, which takes its form from its place (ERR-15).
export operator get<V, S, K>(store: S, key: K) -> result<V, error>
export operator has<S, K>(store: S, key: K) -> bool
export operator put<S, K, V>(store: S, key: K, value: V)

# The symbol operators. Syntax binds each identity (the language's generics
# chapter): `a + b` is `add_(a, b)`. An operator is neither value nor
# temporal; the candidate a call selects is.

/**
Add two operands with `+`.

Floating sums round to binary64 and preserve IEEE special values. An
instant moves by elapsed time, keeping its zone if it has one. A date
plus a duration starts at midnight. A months-and-days tenor moves a date
by its months first, falling back to the last day of a shorter month.

| Operands | Result |
| --- | --- |
| Two `i64` values | `i64` sum |
| Two `f64` values, or `i64` and `f64` in either order | `f64` sum |
| Two `str` values | `str`, with the right text after the left |
| Two `duration` values | `duration` sum |
| `datetime`, `civil_datetime` or `zoned_datetime` and a `duration`, in either order | The moved instant, of the same instant type |
| `date` and `duration`, in either order | `civil_datetime` |
| `date` and `time`, in either order | `civil_datetime` on that date at that time |
| Two `tenor` values of the same form | `tenor`, with their counts added |
| `date` on the left and `tenor` on the right | `date` moved by the tenor |

Type Args:
    L: The left operand's type.
    R: The right operand's type.
    O: The sum's type.

Args:
    lhs: The first operand.
    rhs: The operand to add.

Options:
    - `calendar`: which dates count as business days for `date + tenor`.
      Defaults to `Weekdays()`. Supply a value for which `business_day`
      takes that value and a date and gives a bool, as in `day +{calendar: market} period`.
    - `rolling_rule`: how to adjust a moved date for `date + tenor`.
      Without it, use the date the tenor gives. Supply a value for which
      `roll` takes that value, the calendar and a date and gives a date,
      as in `day +{rolling_rule: Rolling.following} period`.
    - `invalid`: use `lhs +{invalid: .identity} rhs` in a graph where the
      operand types are the same and value addition returns that type.
      With none given, ordinary lifting applies.

Returns:
    The sum in the type shown above. For a difference, use `sub_`.

Raises:
    - `numeric.out_of_range`: an integer, instant, duration or tenor count
      result is outside its range.
    - `tenor.mixed_units`: a business-day tenor and a months-and-days tenor
      are added.

Ticks:
    Ordinary lifting publishes on an admitted evaluation following an input
    notification, including for an equal result. With `.identity`, input
    invalidation can also wake the node. Silence adds no work.

Validity:
    Ordinary lifting needs each temporal operand valid. Retained values
    suffice. With `.identity`, add two valid values, pass through the sole
    valid one, or invalidate the output when neither is valid.

Examples:
    ~~~hgl
    fn sum(left: i64, right: i64) -> i64 => left + right
    fn identity_sum(left: i64, right: i64) -> i64 =>
        left +{invalid: .identity} right

    assert 8 + 3 == 11
    assert 1.5 + 0.5 == 2.0
    let count: i64 = 2
    let part: f64 = 0.5
    assert count + part == 2.5
    assert part + count == 2.5
    assert "bid" + " price" == "bid price"
    assert 1h + 30m == 90m

    let instant = @2026-09-03T09:30Z
    let day = @2026-09-03
    let civil = @2026-09-03T09:30
    let zoned = @2026-03-29T00:30+00:00[Europe/London]
    assert instant + 5m == @2026-09-03T09:35Z
    assert 5m + instant == @2026-09-03T09:35Z
    assert civil + 5m == @2026-09-03T09:35
    assert 5m + civil == @2026-09-03T09:35
    assert zoned + 1h == @2026-03-29T02:30+01:00[Europe/London]
    assert 1h + zoned == @2026-03-29T02:30+01:00[Europe/London]
    assert day + 36h == @2026-09-04T12:00
    assert 36h + day == @2026-09-04T12:00
    assert day + @09:30 == civil
    assert @09:30 + day == civil

    assert 6M + 6M == 1Y
    assert 2B + 1B == 3B
    assert @2026-01-31 + 1M1D == @2026-03-01
    assert @2026-01-03 + 0B == @2026-01-05
    assert @2026-01-31 +{calendar: Weekdays(), rolling_rule: Rolling.following} 1M ==
        @2026-03-02

    assert eval sum(left: [7, _, 9, 9], right: [_, 2, _, _]) == [_, 9, 11, 11]
    assert eval identity_sum(left: [7, _, 9], right: [_, 2, _]) == [7, 9, 11]

    let largest: i64 = 9223372036854775807
    assert raises("numeric.out_of_range") { largest + 1 }
    assert raises("tenor.mixed_units") { 2B + 1M }
    ~~~

Rules:
    NUM-1, NUM-2, NUM-8, OPS-1, OPS-9, OPS-10, TEN-1, TEN-2, TEN-4,
    TEN-5, TEN-6, TEN-7, END-4, FN-6, FN-11, GEN-4, GEN-6
*/
export operator add_<L, R, O>(lhs: L, rhs: R) -> O

/**
Subtract the right operand from the left with binary `-`.

Floating differences round to binary64 and preserve IEEE special values.
Subtracting a duration from a date measures from the start of that date.
Subtracting one from a zoned instant moves the instant in the same zone.
Taking a tenor from a date moves it as adding the negated tenor does.

| Left | Right | Result |
| --- | --- | --- |
| `i64` | `i64` | `i64` difference |
| `i64` or `f64` | `i64` or `f64`, with at least one `f64` | `f64` difference |
| `duration` | `duration` | `duration` difference |
| `datetime`, `civil_datetime` or `zoned_datetime` | `duration` | The moved instant, of the left operand's type |
| `date` | `duration` | `civil_datetime` |
| `datetime`, `date` or `civil_datetime` | The same type as the left operand | `duration` between the two |
| `tenor` | A `tenor` of the same form | `tenor`, with their counts subtracted |
| `date` | `tenor` | `date` moved back by the tenor |

Type Args:
    L: The left operand's type.
    R: The right operand's type.
    O: The difference's type.

Args:
    lhs: The starting value.
    rhs: The amount to take away or the value to subtract.

Options:
    - `calendar`: which dates count as business days for `date - tenor`.
      Defaults to `Weekdays()`. Supply a value for which `business_day`
      takes that value and a date and gives a bool, as in `day -{calendar: market} period`.
    - `rolling_rule`: how to adjust a moved date for `date - tenor`.
      Without it, use the date the tenor gives. Supply a value for which
      `roll` takes that value, the calendar and a date and gives a date,
      as in `day -{rolling_rule: Rolling.preceding} period`.
    - `invalid`: use `lhs -{invalid: .identity} rhs` in a graph where the
      operand types are the same and value subtraction and negation
      return that type. With none given, ordinary lifting applies.

Returns:
    The difference in the type shown above. To negate one operand, use `neg_`.

Raises:
    - `numeric.out_of_range`: an integer, instant, duration or tenor count
      result is outside its range.
    - `tenor.mixed_units`: one tenor counts business days and the other
      counts months and days.

Ticks:
    Ordinary lifting publishes on an admitted evaluation following an input
    notification, including for an equal result. With `.identity`, input
    invalidation can also wake the node. Silence adds no work.

Validity:
    Ordinary lifting needs each temporal operand valid. Retained values
    suffice. With `.identity`, subtract two valid values, pass through a
    sole valid left value, negate a sole valid right value, or invalidate
    the output when neither is valid.

Examples:
    ~~~hgl
    fn difference(left: i64, right: i64) -> i64 => left - right
    fn identity_difference(left: i64, right: i64) -> i64 =>
        left -{invalid: .identity} right

    assert 8 - 3 == 5
    assert 1.5 - 0.5 == 1.0
    let count: i64 = 2
    let part: f64 = 0.5
    assert count - part == 1.5
    assert part - count == -1.5
    assert 90m - 30m == 1h

    assert @2026-09-03T09:30Z - 5m == @2026-09-03T09:25Z
    assert @2026-09-03T09:30 - 5m == @2026-09-03T09:25
    assert @2026-03-29T02:30+01:00[Europe/London] - 1h ==
        @2026-03-29T00:30+00:00[Europe/London]
    assert @2026-09-03 - 1h == @2026-09-02T23:00
    assert @2026-09-03T09:30Z - @2026-09-03T09:00Z == 30m
    assert @2026-09-03 - @2026-09-02 == 24h
    assert @2026-09-03T09:30 - @2026-09-03T09:00 == 30m

    assert 1Y - 6M == 6M
    assert 3B - 1B == 2B
    assert @2026-03-31 - 1M == @2026-02-28
    assert @2026-01-03 - 0B == @2026-01-02
    assert @2026-03-31 -{calendar: Weekdays(), rolling_rule: Rolling.preceding} 1M ==
        @2026-02-27

    assert eval difference(left: [_, 7, 9], right: [2, _, _]) == [_, 5, 7]
    assert eval identity_difference(left: [_, 7, 9], right: [2, _, _]) == [-2, 5, 7]

    let smallest: i64 = -9223372036854775808
    assert raises("numeric.out_of_range") { 0 - smallest }
    assert raises("tenor.mixed_units") { 2B - 1M }
    ~~~

Rules:
    NUM-1, NUM-2, NUM-8, OPS-1, OPS-9, OPS-10, TEN-1, TEN-2, TEN-4,
    TEN-5, TEN-6, TEN-7, END-4, FN-6, FN-11, GEN-4, GEN-6
*/
export operator sub_<L, R, O>(lhs: L, rhs: R) -> O

/**
Multiply two operands with `*`.

Floating products round to binary64 and preserve IEEE special values.
Duration scaling rounds to the nearest microsecond, with ties to even.
A tenor's counts are scaled separately. Repeating a string zero times
gives an empty string.

| Operands | Result |
| --- | --- |
| Two `i64` values | `i64` product |
| Two `f64` values, or `i64` and `f64` in either order | `f64` product |
| `duration` and `i64` or `f64`, in either order | Scaled `duration` |
| `tenor` and `i64`, in either order | Scaled `tenor` |
| `str` and `i64`, in either order | Repeated `str` |

Type Args:
    L: The left operand's type.
    R: The right operand's type.
    O: The product's type.

Args:
    lhs: The first factor.
    rhs: The second factor.

Returns:
    The product, scaled value or repeated text shown above. For a quotient,
    use `div_`.

Raises:
    - `numeric.out_of_range`: an integer, duration or tenor count result
      is outside its range, a NaN or infinity scales a duration, or a
      text repetition count is negative.

Ticks:
    A lifted call publishes on each admitted evaluation following an input
    notification, including for an equal result.

Validity:
    Each temporal operand of a lifted call must be valid. Retained values suffice.

Examples:
    ~~~hgl
    fn product(left: i64, right: i64) -> i64 => left * right

    assert 4 * 3 == 12
    assert 1.5 * 2.0 == 3.0
    let count: i64 = 3
    let part: f64 = 0.5
    assert count * part == 1.5
    assert part * count == 1.5

    assert 1s * count == 3s
    assert count * 1s == 3s
    assert 1us * part == 0us
    assert part * 3us == 2us
    assert 1M2D * count == 3M6D
    assert count * 2B == 6B
    assert "ab" * count == "ababab"
    assert count * "ab" == "ababab"
    assert "ab" * 0 == ""

    assert eval product(left: [3, _, 4], right: [_, 2, _]) == [_, 6, 8]
    ~~~

Rules:
    NUM-1, NUM-2, NUM-8, OPS-1, OPS-10, TEN-1, TEN-2, FN-6, FN-11, GEN-4
*/
export operator mul_<L, R, O>(lhs: L, rhs: R) -> O

/**
Divide with `/` to get the quotient, including its fractional part.

A duration quotient rounds to the nearest microsecond, with ties to even.
For a quotient rounded down, use `floordiv_`.

| Numerator | Divisor | Quotient |
| --- | --- | --- |
| `i64` or `f64` | `i64` or `f64` | `f64` |
| `duration` | `duration` | `f64` ratio |
| `duration` | `i64` or `f64` | `duration` |

Type Args:
    L: The numerator's type.
    R: The divisor's type.
    O: The quotient's type, or its result type under `.error`.

Args:
    lhs: The number or duration to divide.
    rhs: The divisor.

Options:
    - `zero`: a compile-time `ZeroPolicy`, written as in `lhs /{zero: .error} rhs`.
      For an `f64` quotient, the default is `.ieee`. A finite nonzero numerator
      over signed zero gives infinity with the combined signs, and zero over
      zero gives NaN. `.nan` gives NaN for every zero divisor. Both choices
      require an `f64` quotient.
      `.error` gives a result for any quotient type. `.fail` raises on zero
      and is the default for a duration quotient.

Returns:
    The quotient shown above. Under `.error` it is `ok(quotient)`, or an
    `err` with `numeric.division_by_zero` for either signed zero divisor.
    The option checks only the divisor. Use `?` to propagate an error
    result.

Raises:
    - `numeric.division_by_zero`: the divisor is zero under `.fail`.
    - `numeric.out_of_range`: the duration quotient is outside its range,
      or the divisor of a duration quotient is NaN or infinity.

Ticks:
    A lifted call publishes on each admitted evaluation following an input
    notification, including an equal result. A checked error is a publication.

Validity:
    Each temporal operand of a lifted call must be valid. Retained values suffice.

Examples:
    ~~~hgl
    fn quotient(left: i64, right: i64) -> f64 => left / right

    assert 7 / 2 == 3.5
    assert 7.0 / 2.0 == 3.5
    let count: i64 = 2
    let real: f64 = 7.0
    assert count / real == 2.0 / 7.0
    assert real / count == 3.5
    assert 90m / 1h == 1.5
    assert 1s / count == 500ms
    assert 3us / 2.0 == 2us
    assert convert<str>(1.0 / -0.0) == "-inf"

    let divided: result<f64, error> = 1.0 /{zero: .error} 0.0
    assert is_err(divided)
    if is_err(divided) {
        assert divided.error.code == "numeric.division_by_zero"
    }

    assert eval quotient(left: [7, _, 9], right: [_, 2, _]) == [_, 3.5, 4.5]
    ~~~

Rules:
    NUM-1, NUM-2, NUM-3, NUM-8, NUM-9, NUM-10, NUM-12, OPS-1, OPS-10,
    FN-6, FN-11, EXPR-12, GEN-4, GEN-6
*/
export operator div_<L, R, O>(lhs: L, rhs: R) -> O

/**
Divide with `//` to round the quotient toward negative infinity.

For floating operands that include an infinity or NaN and a nonzero
divisor, the result is the floor of the IEEE quotient. Use `div_` to
retain the fractional part or `mod_` for the numeric remainder.

| Numerator | Divisor | Quotient |
| --- | --- | --- |
| `i64` | `i64` | `i64` |
| `i64` or `f64` | `i64` or `f64`, with at least one `f64` | `f64` |
| `duration` | `duration` | `i64` |

Type Args:
    L: The numerator's type.
    R: The divisor's type.
    O: The quotient's type, or its result type under `.error`.

Args:
    lhs: The number or duration to divide.
    rhs: The divisor.

Options:
    - `zero`: a compile-time `ZeroPolicy`, written as in `lhs //{zero: .error} rhs`.
      For an `f64` quotient, `.ieee` is the default and gives the floored IEEE
      quotient. `.nan` gives NaN on zero. Both choices require an `f64`
      quotient. `.error` gives a result for any quotient type. `.fail` raises
      on zero and is the default for an `i64` quotient.

Returns:
    The floored quotient shown above. Under `.error` it is `ok(quotient)`,
    or an `err` with `numeric.division_by_zero` for either signed zero
    divisor. The option checks only the divisor. Use `?` to propagate an
    error result.

Raises:
    - `numeric.division_by_zero`: the divisor is zero under `.fail`.
    - `numeric.out_of_range`: the integer quotient is outside the `i64` range.

Ticks:
    A lifted call publishes on each admitted evaluation following an input
    notification, including an equal result. A checked error is a publication.

Validity:
    Each temporal operand of a lifted call must be valid. Retained values suffice.

Examples:
    ~~~hgl
    fn whole_quotient(left: i64, right: i64) -> i64 => left // right

    assert 7 // 3 == 2
    assert -7 // 3 == -3
    assert -7.0 // 3.0 == -3.0
    let count: i64 = 3
    let real: f64 = 7.0
    assert count // real == 0.0
    assert real // count == 2.0
    assert 7s // 3s == 2

    let divided: result<i64, error> = 7 //{zero: .error} 0
    assert is_err(divided)
    if is_err(divided) {
        assert divided.error.code == "numeric.division_by_zero"
    }

    assert eval whole_quotient(left: [7, _, -7], right: [_, 3, _]) == [_, 2, -3]
    ~~~

Rules:
    NUM-1, NUM-2, NUM-3, NUM-8, NUM-9, NUM-10, NUM-12, OPS-1,
    FN-6, FN-11, EXPR-12, GEN-4, GEN-6
*/
export operator floordiv_<L, R, O>(lhs: L, rhs: R) -> O

/**
Take the remainder of numeric division with `%`.

For integers and finite floating operands, a nonzero remainder has the
divisor's sign. With an infinity or NaN and a nonzero divisor, floating
modulo follows IEEE `fmod`. A remainder by an infinity is the numerator
as it is, whatever its sign. For a floored quotient, use `floordiv_`.

| Dividend | Divisor | Remainder |
| --- | --- | --- |
| `i64` | `i64` | `i64` |
| `i64` or `f64` | `i64` or `f64`, with at least one `f64` | `f64` |

Type Args:
    L: The dividend's type.
    R: The divisor's type.
    O: The remainder's type, or its result type under `.error`.

Args:
    lhs: The dividend.
    rhs: The divisor.

Options:
    - `zero`: a compile-time `ZeroPolicy`, written as in `lhs %{zero: .error} rhs`.
      For an `f64` remainder, the default is `.ieee`. It and `.nan` both
      give NaN on zero and require an `f64` remainder. `.error` gives a result
      for either remainder type. `.fail` raises on zero and is the default
      for an `i64` remainder.

Returns:
    The remainder shown above. Under `.error` it is `ok(remainder)`,
    or an `err` with `numeric.division_by_zero` for either signed zero
    divisor. The option checks only the divisor. Use `?` to propagate an
    error result.

Raises:
    - `numeric.division_by_zero`: the divisor is zero under `.fail`.

Ticks:
    A lifted call publishes on each admitted evaluation following an input
    notification, including an equal result. A checked error is a publication.

Validity:
    Each temporal operand of a lifted call must be valid. Retained values suffice.

Examples:
    ~~~hgl
    fn remainder(left: i64, right: i64) -> i64 => left % right

    assert 7 % 3 == 1
    assert -7 % 3 == 2
    assert -7.0 % 3.0 == 2.0
    let count: i64 = 3
    let real: f64 = 7.0
    assert count % real == 3.0
    assert real % count == 1.0

    let infinity: f64 = 1.0 / 0.0
    assert -3.0 % infinity == -3.0

    assert eval remainder(left: [7, _, -7], right: [_, 3, _]) == [_, 1, 2]
    ~~~

Rules:
    NUM-1, NUM-2, NUM-3, NUM-8, NUM-9, NUM-10, NUM-12,
    FN-6, FN-11, EXPR-12, GEN-4, GEN-6
*/
export operator mod_<L, R, O>(lhs: L, rhs: R) -> O

/**
Reverse the sign of one operand with unary `-`.

Floating negation preserves IEEE special values and reverses the sign
of zero. For a difference of two operands, use `sub_`.

| Operand | Result |
| --- | --- |
| `i64` | Negated `i64` |
| `f64` | Negated `f64` |
| `duration` | Negated `duration` |
| `tenor` | `tenor` with each count negated |

Type Args:
    T: The operand's type.
    O: The negated value's type.

Args:
    value: The value to negate.

Returns:
    The negated value in the operand's type for the forms shown above.

Raises:
    - `numeric.out_of_range`: the negated integer, duration or tenor count
      is outside its range. This includes negating the least `i64`.

Ticks:
    A lifted call publishes on each admitted evaluation following an input
    notification, including for an equal result.

Validity:
    A temporal operand must be valid.

Examples:
    ~~~hgl
    fn opposite(value: i64) -> i64 => -value

    let change: i64 = 3
    assert -change == -3
    let fraction: f64 = 0.5
    assert -fraction == -0.5
    let elapsed = 3s
    assert -elapsed == -3s
    let period = 1M2D
    assert -period + period == 0D
    let business_days = 2B
    assert -business_days + business_days == 0B

    assert eval opposite(value: [_, 3, _, 3, -2]) == [_, -3, _, -3, 2]

    let smallest: i64 = -9223372036854775808
    assert raises("numeric.out_of_range") { -smallest }
    ~~~

Rules:
    NUM-1, NUM-2, NUM-8, OPS-1, OPS-10, TEN-1, TEN-2, FN-6, FN-11, GEN-4
*/
export operator neg_<T, O>(value: T) -> O

# `==`, `!=`, `<`, `<=`, `>`, `>=`.
export operator eq_<L, R>(lhs: L, rhs: R) -> bool
export operator ne_<L, R>(lhs: L, rhs: R) -> bool
export operator lt_<L, R>(lhs: L, rhs: R) -> bool
export operator le_<L, R>(lhs: L, rhs: R) -> bool
export operator gt_<L, R>(lhs: L, rhs: R) -> bool
export operator ge_<L, R>(lhs: L, rhs: R) -> bool

# `<=>`.
export operator compare_<L, R>(lhs: L, rhs: R) -> CmpResult

# `convert<T>(value)`: the value as a T (OPS-4). A call gives T and leaves V
# to be inferred from the value. The result O is T, or `result<T, error>`
# for a conversion that can fail and returns its failure (OPS-8).
export operator convert<T, V, O>(value: V) -> O
    requires O in {T, result<T, error>}

# `&&`, `||`, `!`, and a chain of three or more `&&` or `||` (OPS-5).
export operator and_(lhs: bool, rhs: bool) -> bool
export operator or_(lhs: bool, rhs: bool) -> bool
export operator not_(value: bool) -> bool
export operator all_(values: ...bool) -> bool
export operator any_(values: ...bool) -> bool

# Reverse-order candidates reuse one native body for each commutative pair.
# Arguments have already been evaluated; only their bound values are swapped.

# NUM-1: mixed numeric addition and multiplication.
impl const fn add_(lhs: f64, rhs: i64) -> f64 => add_(rhs, lhs)
impl const fn mul_(lhs: f64, rhs: i64) -> f64 => mul_(rhs, lhs)

# OPS-1: temporal addition, duration scaling, and string repetition.
impl const fn add_(lhs: duration, rhs: datetime) -> datetime => add_(rhs, lhs)
impl const fn add_(lhs: duration, rhs: date) -> civil_datetime => add_(rhs, lhs)
impl const fn add_(lhs: duration, rhs: civil_datetime) -> civil_datetime => add_(rhs, lhs)
impl const fn add_(lhs: duration, rhs: zoned_datetime) -> zoned_datetime => add_(rhs, lhs)
impl const fn add_(lhs: time, rhs: date) -> civil_datetime => add_(rhs, lhs)
impl const fn mul_(lhs: i64, rhs: duration) -> duration => mul_(rhs, lhs)
impl const fn mul_(lhs: f64, rhs: duration) -> duration => mul_(rhs, lhs)
impl const fn mul_(lhs: i64, rhs: str) -> str => mul_(rhs, lhs)

# NUM-2, NUM-4, NUM-5: preserve the integer's type and both tolerances.
impl const fn eq_(lhs: f64, rhs: i64, abs: f64 = 0.0, rel: f64 = 0.0) -> bool =>
    eq_(rhs, lhs, abs: abs, rel: rel)
impl const fn ne_(lhs: f64, rhs: i64, abs: f64 = 0.0, rel: f64 = 0.0) -> bool =>
    ne_(rhs, lhs, abs: abs, rel: rel)

# OPS-9: the required option keeps these candidates out of unconfigured calls.
# The requirements name value operations; a runtime body calls those candidates.
impl fn add_<T, const invalid: InvalidInputPolicy>(lhs: T, rhs: T) -> T
    requires invalid == .identity && add_(T, T) -> T {
    inject out
    when valid(lhs, rhs) { return add_(lhs, rhs) }
    when valid(lhs) { return lhs }
    when valid(rhs) { return rhs }
    when valid([]) { invalidate(out) }
}

impl fn sub_<T, const invalid: InvalidInputPolicy>(lhs: T, rhs: T) -> T
    requires invalid == .identity && sub_(T, T) -> T && neg_(T) -> T {
    inject out
    when valid(lhs, rhs) { return sub_(lhs, rhs) }
    when valid(lhs) { return lhs }
    when valid(rhs) { return neg_(rhs) }
    when valid([]) { invalidate(out) }
}
