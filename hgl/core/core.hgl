module core

# Core's mandatory module: every module binds its public declarations
# without a `use` (UNIT-11). Contracts: spec/numeric-operators.md,
# spec/scalar-operators.md, spec/capabilities.md,
# spec/temporal-endpoints.md, spec/list-operations.md,
# spec/tenor-operations.md and spec/execution.md. The native candidates
# are in hgl/native/scalar_operators.hgl, the capabilities in
# hgl/native/capabilities.hgl, the endpoint operations in
# hgl/native/endpoints.hgl, the list operations in hgl/native/lists.hgl
# and a tenor's in hgl/native/tenors.hgl. The calendar, the rolling rule
# and the candidates that move a date are in hgl/core/calendar.hgl.

# The outcome of a full comparison, `<=>` (OPS-3, NUM-6).
export enum CmpResult { less, equivalent, greater, unordered }

# What a division does with a zero divisor (NUM-3, NUM-9, NUM-12).
export enum ZeroPolicy { ieee, nan, error, fail }

# How an `f64` is rounded to an `i64` (OPS-8).
export enum Rounding { truncate, floor, ceiling, half_even, half_up, half_down }

# What a conversion does when it fails (OPS-8).
export enum InvalidPolicy { error, fail }

# Admission for same-type temporal addition/subtraction (OPS-9).
export enum InvalidInputPolicy { identity }

# The level of a log record (CAP-2).
export enum LogLevel { debug, info, warning, error }

# The named times of a run (CRUN-3). `smallest_step` is the least by which
# one cycle's evaluation time follows another's. `never` is before every
# evaluation time and `forever` after every one: no cycle runs at either.
# `earliest_start` is the first instant a run may start at, and
# `latest_end` the last it may end at.
export const smallest_step: duration = 1us
export const never: datetime = @1970-01-01T00:00:00Z
export const earliest_start: datetime = never + smallest_step
export const forever: datetime = @2262-04-11T00:00:00Z
export const latest_end: datetime = forever - smallest_step

# `log` at each level (CAP-2). The native `log` and the capability types
# are in hgl/native/capabilities.hgl.
export const fn log_debug(logger: Logger, message: str) {
    log(logger, .debug, message)
}

export const fn log_info(logger: Logger, message: str) {
    log(logger, .info, message)
}

export const fn log_warning(logger: Logger, message: str) {
    log(logger, .warning, message)
}

export const fn log_error(logger: Logger, message: str) {
    log(logger, .error, message)
}

# `replay` and `record` are a run's own (CEVAL-1, CRUN-8). They are not
# exported: a run wires them, and no module names them, so a program may
# use either name for a declaration of its own.

# The publications a replay list holds, each at its time (CEVAL-2,
# CEVAL-3). A window's are its arrivals; the window takes its values out
# itself (END-9). An eval's run wires one to each temporal input of its
# target (CEVAL-1).
fn replay<T>(const items: list<tuple<datetime, delta<T>>>) -> T {
    for item in items {
        yield item[0]: item[1]
    }
}

# Each publication of `input`, with its evaluation time, put in the store
# under `key` at stop (CEVAL-4). The delta is read into a `result`: a
# cycle in which a value only leaves a window of a duration has none, and
# adds no tuple (END-3, END-9). A run wires one to its entry's result
# under the run's key (CRUN-8).
fn record<T>(input: T, const key: str) {
    cache entries: list<tuple<datetime, delta<T>>> = []
    inject clock, global_state
    when valid(input) && modified(input) {
        let change: result<delta<T>, error> = delta_value(input)
        if is_ok(change) { append(entries, (clock.evaluation_time, change.value)) }
    }
    stop { put(global_state, key, entries) }
}

# Ask for a wake on a scheduler or an alarm (CAP-4, CAP-5). `at` is a
# `duration` from the current evaluation time, or a `datetime`.
export operator schedule<C, W>(capability: C, at: W)

# The global store (CAP-6): the value under a key, whether a key holds
# one, and a value put under a key. A call of `get` writes `V` and leaves
# the store and the key to be inferred, as `convert<T>(value)` does. `get`
# can fail, a dictionary's (the language's ERR-6) and the store's: it gives
# a `result<V, error>`, which takes its form from its place (ERR-15).
export operator get<V, S, K>(store: S, key: K) -> result<V, error>
export operator has<S, K>(store: S, key: K) -> bool
export operator put<S, K, V>(store: S, key: K, value: V)

# The symbol operators. Syntax binds each identity (the language's generics
# chapter): `a + b` is `add_(a, b)`. An operator is neither value nor
# temporal; the candidate a call selects is.

/**
Add two operands with `+`.

For numbers, two `i64` operands give an `i64`. An `f64` operand gives an
`f64`, rounded to binary64 with IEEE special values. Addition also joins
two strings, sums durations or tenors of the same form, moves an instant
by a duration, combines a date and a time, or moves a date by a tenor.
A date combined with a time or a duration gives a `civil_datetime`.

Type Args:
    L: The type of the left operand.
    R: The type of the right operand.
    O: The type the selected candidate gives for the sum.

Args:
    lhs: The first operand.
    rhs: The operand to add.

    A date plus a tenor takes `calendar`, which defaults to `Weekdays()`,
    and `rolling_rule`, which defaults to leaving the moved date as is.
    The calendar answers `business_day`. The rolling rule applies `roll`.

    In a graph, the `invalid: .identity` option adds two valid inputs of one
    type, passes through the sole valid input, or invalidates the output
    when neither is valid. This requires a value addition that returns
    the same type as both operands. Omission uses ordinary lifting and
    validity. Under `.identity`, invalidation can activate the node.
    Silence adds no work.

Returns:
    The sum in the selected result type. For a difference, use `sub_`.

Raises:
    `numeric.out_of_range` if an integer, duration, instant or tenor count
    result is outside its range. `tenor.mixed_units` for a business-day
    tenor added to a months-and-days tenor.

Examples:
    ~~~hgl
    assert 8 + 3 == 11
    let count: i64 = 2
    assert count + 0.5 == 2.5

    let largest: i64 = 9223372036854775807
    assert raises("numeric.out_of_range") { largest + 1 }
    ~~~

Rules:
    NUM-1, NUM-2, NUM-8, OPS-1, OPS-9, OPS-10, TEN-1, TEN-2, TEN-4,
    TEN-5, TEN-6, TEN-7, GEN-4, GEN-6
*/
export operator add_<L, R, O>(lhs: L, rhs: R) -> O

/**
Subtract the right operand from the left with binary `-`.

For numbers, two `i64` operands give an `i64`. An `f64` operand gives an
`f64`, rounded to binary64 with IEEE special values. Subtraction also
takes a duration away from an instant or another duration. A date less
a duration gives a `civil_datetime`. Two dates, two civil datetimes or
two UTC datetimes give a duration. A tenor can be taken from a date or
from a tenor of the same form.

Type Args:
    L: The type of the left operand.
    R: The type of the right operand.
    O: The type the selected candidate gives for the difference.

Args:
    lhs: The starting value.
    rhs: The amount to take away or the value to subtract.

    A date less a tenor takes `calendar`, which defaults to `Weekdays()`,
    and `rolling_rule`, which defaults to leaving the moved date as is.
    The calendar answers `business_day`. The rolling rule applies `roll`.

    In a graph, the `invalid: .identity` option subtracts two valid inputs
    of one type, passes through a sole valid left input, negates a sole
    valid right input, or invalidates the output when neither is valid.
    This requires value subtraction and negation that return the same
    type as the operands. Omission uses ordinary lifting and validity.
    Under `.identity`, invalidation can activate the node. Silence adds
    no work.

Returns:
    The difference in the selected result type. To negate one operand,
    use `neg_`.

Raises:
    `numeric.out_of_range` if an integer, duration, instant or tenor count
    result is outside its range. `tenor.mixed_units` for subtraction
    between a business-day tenor and a months-and-days tenor.

Examples:
    ~~~hgl
    assert 8 - 3 == 5
    let count: i64 = 2
    assert 0.5 - count == -1.5

    let smallest: i64 = -9223372036854775808
    assert raises("numeric.out_of_range") { 0 - smallest }
    ~~~

Rules:
    NUM-1, NUM-2, NUM-8, OPS-1, OPS-9, OPS-10, TEN-1, TEN-2, TEN-4,
    TEN-5, TEN-6, TEN-7, GEN-4, GEN-6
*/
export operator sub_<L, R, O>(lhs: L, rhs: R) -> O

/**
Multiply two operands with `*`.

Two `i64` operands give an `i64`. An `f64` among two numeric operands
gives an `f64`, rounded to binary64 with IEEE special values. A number
scales a duration, rounded to the nearest microsecond with ties to even.
An `i64` scales each count of a tenor or repeats a string, with a count
of zero giving the empty string. Each of these accepts either order.

Type Args:
    L: The type of the left operand.
    R: The type of the right operand.
    O: The type the selected candidate gives for the product.

Args:
    lhs: The first factor.
    rhs: The second factor.

Returns:
    The numeric product, scaled duration or tenor, or repeated text.
    For a quotient, use `div_`.

Raises:
    `numeric.out_of_range` for an out-of-range integer, duration or tenor
    count, a NaN or infinity scaling a duration, or a negative text count.

Examples:
    ~~~hgl
    assert 4 * 3 == 12
    let count: i64 = 3
    assert count * 0.5 == 1.5

    assert 1us * 0.5 == 0us
    assert 3us * 0.5 == 2us
    ~~~

Rules:
    NUM-1, NUM-2, NUM-8, OPS-1, OPS-10, TEN-1, TEN-2, GEN-4
*/
export operator mul_<L, R, O>(lhs: L, rhs: R) -> O

/**
Divide with `/` to get the quotient, including its fractional part.

Two numbers or two durations give an `f64`. A duration divided by a
number stays a duration, rounded to the nearest microsecond with ties
to even. For a quotient rounded down, use `floordiv_`.

Type Args:
    L: The type of the numerator.
    R: The type of the divisor.
    O: The selected quotient type, or its `result` form under `.error`.

Args:
    lhs: The number or duration to divide.
    rhs: The divisor.

    `zero` is a compile-time `ZeroPolicy`, written as in
    `lhs /{zero: .error} rhs`. An `f64` quotient defaults to `.ieee`
    and also admits `.nan`, `.error` and `.fail`. Under `.ieee`, a
    finite nonzero numerator divided by signed zero gives an infinity
    with the combined signs, and zero divided by zero gives NaN.
    `.nan` gives NaN for every zero divisor. A duration quotient
    defaults to `.fail` and also admits `.error`. An unsupported policy
    rejects during source checking (`operator.no_candidate`).

Returns:
    The quotient if the policy returns a plain value. Under `.error`,
    a successful division gives `ok(quotient)`, and either signed zero
    divisor gives an Err with `numeric.division_by_zero`. The Err is
    result data. Use `?` to propagate it. The zero policy checks only
    the divisor.

Raises:
    `numeric.division_by_zero` on zero under `.fail`.
    `numeric.out_of_range` for a duration quotient outside its range
    or a duration divided by NaN or infinity.

Examples:
    ~~~hgl
    assert 7 / 2 == 3.5
    assert convert<str>(1.0 / -0.0) == "-inf"

    let divided: result<f64, error> = 1.0 /{zero: .error} 0.0
    assert is_err(divided)
    if is_err(divided) {
        assert divided.error.code == "numeric.division_by_zero"
    }
    ~~~

Rules:
    NUM-1, NUM-2, NUM-3, NUM-8, NUM-9, NUM-10, NUM-12, OPS-1, OPS-6,
    OPS-10, EXPR-12, GEN-4, GEN-6
*/
export operator div_<L, R, O>(lhs: L, rhs: R) -> O

/**
Divide with `//` to round the quotient toward negative infinity.

Two `i64` operands give an `i64`, and two durations give an `i64`.
An `f64` among numeric operands gives an `f64`. With an infinity or
NaN and a nonzero divisor, that result is the floor of the IEEE
quotient. Use `div_` to keep the fractional part or `mod_` for the
remainder of numeric operands.

Type Args:
    L: The type of the numerator.
    R: The type of the divisor.
    O: The selected quotient type, or its `result` form under `.error`.

Args:
    lhs: The number or duration to divide.
    rhs: The divisor.

    `zero` is a compile-time `ZeroPolicy`, written as in
    `lhs //{zero: .error} rhs`. An `i64` quotient defaults to `.fail`
    and also admits `.error`. An `f64` quotient defaults to `.ieee`
    and also admits `.nan`, `.error` and `.fail`. For a zero divisor,
    `.ieee` uses the floored IEEE quotient and `.nan` gives NaN.
    An unsupported policy rejects during source checking
    (`operator.no_candidate`).

Returns:
    The floored quotient. Under `.error`, a successful division gives
    `ok(quotient)`, and either signed zero divisor gives an Err with
    `numeric.division_by_zero`. The Err is result data. Use `?`
    to propagate it. The zero policy checks only the divisor.

Raises:
    `numeric.division_by_zero` on zero under `.fail`.
    `numeric.out_of_range` if an integer quotient is outside `i64`.

Examples:
    ~~~hgl
    assert 7 // 3 == 2
    assert -7 // 3 == -3

    let divided: result<i64, error> = 7 //{zero: .error} 0
    assert is_err(divided)
    if is_err(divided) {
        assert divided.error.code == "numeric.division_by_zero"
    }
    ~~~

Rules:
    NUM-1, NUM-2, NUM-3, NUM-8, NUM-9, NUM-10, NUM-12, OPS-1,
    EXPR-12, GEN-4, GEN-6
*/
export operator floordiv_<L, R, O>(lhs: L, rhs: R) -> O

/**
Take the remainder of numeric division with `%`.

A nonzero remainder has the divisor's sign for integers and for finite
floating operands. With an infinity or NaN and a nonzero divisor,
floating modulo follows IEEE `fmod`. In particular, a remainder by
an infinity is the numerator as is, whatever its sign. For the floored
quotient of finite operands, use `floordiv_`.

Type Args:
    L: The type of the numerator.
    R: The type of the divisor.
    O: The selected remainder type, or its `result` form under `.error`.

Args:
    lhs: The dividend.
    rhs: The divisor.

    `zero` is a compile-time `ZeroPolicy`, written as in
    `lhs %{zero: .error} rhs`. An `i64` remainder defaults to `.fail`
    and also admits `.error`. An `f64` remainder defaults to `.ieee`
    and also admits `.nan`, `.error` and `.fail`. Both `.ieee` and
    `.nan` give NaN on zero. An unsupported policy rejects during
    source checking (`operator.no_candidate`).

Returns:
    An `i64` remainder for two `i64` operands, or an `f64` when either
    operand is `f64`. Under `.error`, a successful division gives
    `ok(remainder)`, and either signed zero divisor gives an Err with
    `numeric.division_by_zero`. The Err is result data. Use `?`
    to propagate it. The zero policy checks only the divisor.

Raises:
    `numeric.division_by_zero` on zero under `.fail`.

Examples:
    ~~~hgl
    assert 7 % 3 == 1
    assert -7 % 3 == 2

    let infinity: f64 = 1.0 / 0.0
    assert -3.0 % infinity == -3.0
    ~~~

Rules:
    NUM-1, NUM-2, NUM-3, NUM-8, NUM-9, NUM-10, NUM-12, EXPR-12,
    GEN-4, GEN-6
*/
export operator mod_<L, R, O>(lhs: L, rhs: R) -> O

/**
Reverse the sign of one operand with unary `-`.

Negation preserves the type of a number or duration, and negates
each count of a tenor. Floating negation preserves IEEE special values
and reverses the sign of zero. For a difference, use `sub_`.

Type Args:
    T: The type of the operand.
    O: The type the selected candidate gives for its negation.

Args:
    value: The value to negate.

Returns:
    The negated value in the operand's type for core's numeric, duration
    and tenor candidates.

Raises:
    `numeric.out_of_range` if the negated integer, duration or tenor
    count is outside its range. This includes the least `i64`.

Examples:
    ~~~hgl
    let change: i64 = 3
    assert -change == -3
    let smallest: i64 = -9223372036854775808
    assert raises("numeric.out_of_range") { -smallest }
    ~~~

Rules:
    NUM-1, NUM-2, NUM-8, OPS-1, OPS-10, TEN-1, TEN-2, GEN-4
*/
export operator neg_<T, O>(value: T) -> O

# `==`, `!=`, `<`, `<=`, `>`, `>=`.
export operator eq_<L, R>(lhs: L, rhs: R) -> bool
export operator ne_<L, R>(lhs: L, rhs: R) -> bool
export operator lt_<L, R>(lhs: L, rhs: R) -> bool
export operator le_<L, R>(lhs: L, rhs: R) -> bool
export operator gt_<L, R>(lhs: L, rhs: R) -> bool
export operator ge_<L, R>(lhs: L, rhs: R) -> bool

# `<=>`.
export operator compare_<L, R>(lhs: L, rhs: R) -> CmpResult

# `convert<T>(value)`: the value as a T (OPS-4). A call gives T and leaves V
# to be inferred from the value. The result O is T, or `result<T, error>`
# for a conversion that can fail and returns its failure (OPS-8).
export operator convert<T, V, O>(value: V) -> O
    requires O in {T, result<T, error>}

# `&&`, `||`, `!`, and a chain of three or more `&&` or `||` (OPS-5).
export operator and_(lhs: bool, rhs: bool) -> bool
export operator or_(lhs: bool, rhs: bool) -> bool
export operator not_(value: bool) -> bool
export operator all_(values: ...bool) -> bool
export operator any_(values: ...bool) -> bool

# Reverse-order candidates reuse one native body for each commutative pair.
# Arguments have already been evaluated; only their bound values are swapped.

# NUM-1: mixed numeric addition and multiplication.
impl const fn add_(lhs: f64, rhs: i64) -> f64 => add_(rhs, lhs)
impl const fn mul_(lhs: f64, rhs: i64) -> f64 => mul_(rhs, lhs)

# OPS-1: temporal addition, duration scaling, and string repetition.
impl const fn add_(lhs: duration, rhs: datetime) -> datetime => add_(rhs, lhs)
impl const fn add_(lhs: duration, rhs: date) -> civil_datetime => add_(rhs, lhs)
impl const fn add_(lhs: duration, rhs: civil_datetime) -> civil_datetime => add_(rhs, lhs)
impl const fn add_(lhs: duration, rhs: zoned_datetime) -> zoned_datetime => add_(rhs, lhs)
impl const fn add_(lhs: time, rhs: date) -> civil_datetime => add_(rhs, lhs)
impl const fn mul_(lhs: i64, rhs: duration) -> duration => mul_(rhs, lhs)
impl const fn mul_(lhs: f64, rhs: duration) -> duration => mul_(rhs, lhs)
impl const fn mul_(lhs: i64, rhs: str) -> str => mul_(rhs, lhs)

# NUM-2, NUM-4, NUM-5: preserve the integer's type and both tolerances.
impl const fn eq_(lhs: f64, rhs: i64, abs: f64 = 0.0, rel: f64 = 0.0) -> bool =>
    eq_(rhs, lhs, abs: abs, rel: rel)
impl const fn ne_(lhs: f64, rhs: i64, abs: f64 = 0.0, rel: f64 = 0.0) -> bool =>
    ne_(rhs, lhs, abs: abs, rel: rel)

# OPS-9: the required option keeps these candidates out of unconfigured calls.
# The requirements name value operations; a runtime body calls those candidates.
impl fn add_<T, const invalid: InvalidInputPolicy>(lhs: T, rhs: T) -> T
    requires invalid == .identity && add_(T, T) -> T {
    inject out
    when valid(lhs, rhs) { return add_(lhs, rhs) }
    when valid(lhs) { return lhs }
    when valid(rhs) { return rhs }
    when valid([]) { invalidate(out) }
}

impl fn sub_<T, const invalid: InvalidInputPolicy>(lhs: T, rhs: T) -> T
    requires invalid == .identity && sub_(T, T) -> T && neg_(T) -> T {
    inject out
    when valid(lhs, rhs) { return sub_(lhs, rhs) }
    when valid(lhs) { return lhs }
    when valid(rhs) { return neg_(rhs) }
    when valid([]) { invalidate(out) }
}
