module core part collection_text

# FMT-5: quote strings inside a collection. Other parts use the same
# scalar text or selected conversion as a whole value in a format place.
operator collection_text_member<T>(value: T) -> str
impl const fn collection_text_member(value: str) -> str => format("{:?}", value)
impl const fn collection_text_member<T>(value: T) -> str
    requires T in {date, time, datetime, duration} || convert(T) -> str => format("{}", value)

const fn collection_text_nullable<T>(value: T?) -> str
    requires collection_text_member(T) -> str {
    if value != null { return collection_text_member(value) }
    return "null"
}

# OPS-4, FMT-5: every body traverses its original collection and appends
# directly to the output string, including for fixed lists.
const fn collection_text_append(var text: str, var separator: str, rendered: str) {
    text += separator
    text += rendered
    separator = ", "
}

impl const fn convert<T>(value: list<T>) -> str
    requires collection_text_member(T) -> str {
    var text = "["
    var separator = ""
    for item in value {
        collection_text_append(text, separator, collection_text_member(item))
    }
    text += "]"
    return text
}

impl const fn convert<T, N>(value: list<T, N>) -> str
    requires collection_text_member(T) -> str {
    var text = "["
    var separator = ""
    for item in value {
        collection_text_append(text, separator, collection_text_member(item))
    }
    text += "]"
    return text
}

impl const fn convert<T>(value: list<T?>) -> str
    requires collection_text_member(T) -> str {
    var text = "["
    var separator = ""
    for item in value {
        collection_text_append(text, separator, collection_text_nullable(item))
    }
    text += "]"
    return text
}

impl const fn convert<T, N>(value: list<T?, N>) -> str
    requires collection_text_member(T) -> str {
    var text = "["
    var separator = ""
    for item in value {
        collection_text_append(text, separator, collection_text_nullable(item))
    }
    text += "]"
    return text
}

impl const fn convert<T>(value: set<T>) -> str
    requires collection_text_member(T) -> str {
    var text = "["
    var separator = ""
    for item in value {
        collection_text_append(text, separator, collection_text_member(item))
    }
    text += "]"
    return text
}

impl const fn convert<K, V>(value: dict<K, V>) -> str
    requires collection_text_member(K) -> str && collection_text_member(V) -> str {
    var text = "["
    var separator = ""
    for key, item in value {
        collection_text_append(text, separator, collection_text_member(key))
        text += ": "
        text += collection_text_member(item)
    }
    text += "]"
    return text
}

impl const fn convert<K, V>(value: dict<K, V?>) -> str
    requires collection_text_member(K) -> str && collection_text_member(V) -> str {
    var text = "["
    var separator = ""
    for key, item in value {
        collection_text_append(text, separator, collection_text_member(key))
        text += ": "
        text += collection_text_nullable(item)
    }
    text += "]"
    return text
}
