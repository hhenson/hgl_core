module core part collection_text

# FMT-5: quote string parts, use the scalar formatter for temporal scalars,
# and call every other part's selected text conversion. This operator is private.
operator collection_text_member<T>(value: T) -> str
impl const fn collection_text_member(value: str) -> str => format("{:?}", value)
impl const fn collection_text_member(value: date) -> str => format("{}", value)
impl const fn collection_text_member(value: time) -> str => format("{}", value)
impl const fn collection_text_member(value: datetime) -> str => format("{}", value)
impl const fn collection_text_member(value: duration) -> str => format("{}", value)
impl const fn collection_text_member<T>(value: T) -> str
    requires convert(T) -> str => convert<str>(value)

const fn collection_text_set<T>(values: set<T>) -> str
    requires collection_text_member(T) -> str {
    var text = "["
    var separator = ""
    for value in values {
        text += separator
        text += collection_text_member(value)
        separator = ", "
    }
    text += "]"
    return text
}

const fn collection_text_dict<K, V>(values: dict<K, V>) -> str
    requires collection_text_member(K) -> str && collection_text_member(V) -> str {
    var text = "["
    var separator = ""
    for key, value in values {
        text += separator
        text += collection_text_member(key)
        text += ": "
        text += collection_text_member(value)
        separator = ", "
    }
    text += "]"
    return text
}

# FMT-5: a missing list member or dictionary value is written as null.
const fn collection_text_nullable<T>(value: T?) -> str
    requires collection_text_member(T) -> str {
    if value != null { return collection_text_member(value) }
    return "null"
}

const fn collection_text_list<T>(values: list<T>) -> str
    requires collection_text_member(T) -> str {
    var text = "["
    var separator = ""
    for value in values {
        text += separator
        text += collection_text_member(value)
        separator = ", "
    }
    text += "]"
    return text
}

const fn collection_text_nullable_list<T>(values: list<T?>) -> str
    requires collection_text_member(T) -> str {
    var text = "["
    var separator = ""
    for value in values {
        text += separator
        text += collection_text_nullable(value)
        separator = ", "
    }
    text += "]"
    return text
}

impl const fn convert<T>(value: list<T>) -> str
    requires collection_text_member(T) -> str => collection_text_list(value)
impl const fn convert<T, N>(value: list<T, N>) -> str
    requires collection_text_member(T) -> str => collection_text_list(value)
impl const fn convert<T>(value: list<T?>) -> str
    requires collection_text_member(T) -> str => collection_text_nullable_list(value)
impl const fn convert<T, N>(value: list<T?, N>) -> str
    requires collection_text_member(T) -> str => collection_text_nullable_list(value)
impl const fn convert<T>(value: set<T>) -> str
    requires collection_text_member(T) -> str => collection_text_set(value)
impl const fn convert<K, V>(value: dict<K, V>) -> str
    requires collection_text_member(K) -> str && collection_text_member(V) -> str => collection_text_dict(value)
impl const fn convert<K, V>(value: dict<K, V?>) -> str
    requires collection_text_member(K) -> str && collection_text_member(V) -> str {
    var text = "["
    var separator = ""
    for key, member in value {
        text += separator
        text += collection_text_member(key)
        text += ": "
        text += collection_text_nullable(member)
        separator = ", "
    }
    text += "]"
    return text
}
