module conformance part handler_order

fn total_after_update(value: i64) -> i64 {
    state total: i64 = 0
    when { total += value }
    when { return total }
}

/**
A handler that completes lets the next handler run in the same evaluation.
The second handler reads the state the first one has just updated.

:Rules: TIME-3, TIME-6
:Status: agreed
*/
test a_handler_can_fall_through {
    assert eval(total_after_update(value: [3, 4])) == [3, 7]
}

fn count_unsuppressed(suppress: bool) -> i64 {
    state count: i64 = 0
    when suppress { return count }
    when {
        count += 1
        return count
    }
}

/**
Returning from a handler ends the evaluation before any later handler acts.
The two suppressed ticks report the old count. The final tick reveals whether
either suppressed evaluation changed the state.

:Rules: TIME-3, FN-7
:Status: agreed
*/
test a_return_skips_later_handlers {
    assert eval(count_unsuppressed(suppress: [false, true, true, false])) ==
        [1, 1, 1, 2]
}

fn first_ready(sample: bool, gate: bool, left: i64, right: i64) -> str {
    when modified(sample) && valid(gate, left) { return "left" }
    when modified(sample) && valid(gate, right) { return "right" }
}

/**
Each handler requires its own inputs to be valid. A requirement shared by
both handlers applies to both. Sample each cycle as right, gate, then left
become valid. When both handlers qualify the first return wins.

:Rules: TIME-3, TIME-4
:Status: agreed
*/
test each_handler_checks_its_own_validity_requirements {
    assert eval(first_ready(sample: [true], gate: [true], left: [], right: [])) == []
    assert eval(first_ready(
        sample: [true, true, true],
        gate:   [_,    true, _],
        left:   [_,    _,    7],
        right:  [9,    _,    _])) == [_, "right", "left"]
}

fn report_on_change_or_request(value: i64, requested: bool) -> i64 {
    when modified(value) || requested { return value }
}

/**
A modification predicate inside a disjunction leaves the default subscription
in place. A request alone can wake the handler and publish the retained value.

:Rules: TIME-3, END-1
:Status: agreed
*/
test a_disjunction_preserves_the_default_subscription {
    assert eval(report_on_change_or_request(
        value:     [7,     _,    _,     9],
        requested: [false, true, false, _])) == [7, 7, _, 9]
}
