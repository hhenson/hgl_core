module conformance part generic_resolution

# Each result is the type parameter and nothing more. The membership of
# `first_number` lists `i64` and not `i64?`.
const fn first_entry<T>(entries: list<T>) -> T => entries[0]

const fn first_number<T>(entries: list<T>) -> T
    requires T in {i64, f64} => entries[0]

const fn first_entry_or_null(entries: list<i64>) -> i64? => first_entry(entries)

/**
A nullable place `U?` says of a result that is a type parameter alone only
that the parameter is `U` or `U?`, and the arguments decide which.
A `list<i64>` argument makes `T` an `i64` in each call, and the `i64` it
gives fits the `i64?` place. Were `T` the place's `i64?`, the membership of
`first_number` would not hold.

:Rules: GEN-2, GEN-3, TYPE-14
:Status: agreed
*/
test a_nullable_place_leaves_a_bare_result_to_the_arguments {
    let entries: list<i64> = [7, 8]
    assert first_entry_or_null(entries) == 7
    let number: i64? = first_number(entries)
    assert number == 7
}
