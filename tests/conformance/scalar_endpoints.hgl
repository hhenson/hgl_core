module conformance part scalar_endpoints

# Scalar endpoint observations. Status and rule map: README.md.
# Probe ticks let the observers read an idle or invalid watched input.

fn watched_valid(watched: i64, probe: bool) -> bool {
    when valid() {
        return valid(watched)
    }
}

fn watched_modified(watched: i64, probe: bool) -> bool {
    when valid() {
        return modified(watched)
    }
}

# Only probe is subscribed. Default validity still requires both inputs.
fn sample_on_probe(watched: i64, probe: bool) -> i64 {
    when modified(probe) {
        return watched
    }
}

test silence_preserves_validity {
    assert eval(watched_valid,
                watched: [_, 7, _, _],
                probe: [true, true, true, true]) == [false, true, true, true]
}

test equal_publication_is_modified_and_idle_is_not {
    assert eval(watched_modified,
                watched: [_, 7, _, 7],
                probe: [true, true, true, _]) == [false, true, false, true]
}

test retained_value_is_read_without_a_new_tick {
    assert eval(sample_on_probe,
                watched: [_, 7, _, _, 9, _],
                probe: [true, _, true, true, _, true]) == [_, _, 7, 7, _, 9]
}

fn produce(command: i64) -> i64 {
    inject out
    when {
        if command != 0 { return command }
        invalidate(out)
    }
}

fn watch(input: i64) -> bool {
    when valid() { return valid(input) }
}

fn observe(command: i64) -> bool => watch(produce(command))

test publish_invalidate_recover {
    assert eval(observe, command: [7, 0, 0, 7]) == [true, false, _, true]
}

fn publish_nullable(command: i64) -> i64? {
    when {
        if command == 0 { return null }
        return command
    }
}

fn read_validity(watched: i64?, probe: bool) -> bool {
    when modified(probe) && valid() { return valid(watched) }
}

fn observe_validity(command: i64, probe: bool) -> bool =>
    read_validity(publish_nullable(command), probe)

test publication_establishes_validity {
    assert eval(observe_validity,
                command: [_, 0, _, 7],
                probe: [true, true, true, true]) == [false, true, true, true]
}
