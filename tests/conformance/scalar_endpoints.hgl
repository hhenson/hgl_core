module conformance part scalar_endpoints

# Proposed scalar endpoint observations. Status and rule map: README.md.
# Each observer runs on a probe tick so it can report an idle or invalid
# watched input.

fn watched_valid(watched: i64, probe: bool) -> bool {
    when valid() {
        return valid(watched)
    }
}

fn watched_modified(watched: i64, probe: bool) -> bool {
    when valid() {
        return modified(watched)
    }
}

# Only probe is subscribed. Default validity still requires both inputs.
fn sample_on_probe(watched: i64, probe: bool) -> i64 {
    when modified(probe) {
        return watched
    }
}

test silence_preserves_validity {
    assert eval(watched_valid,
                watched: [_, 7, _, _],
                probe: [true, true, true, true]) == [false, true, true, true]
}

test equal_publication_is_modified_and_idle_is_not {
    assert eval(watched_modified,
                watched: [_, 7, _, 7],
                probe: [true, true, true, _]) == [false, true, false, true]
}

test retained_value_is_read_without_a_new_tick {
    assert eval(sample_on_probe,
                watched: [_, 7, _, _, 9, _],
                probe: [true, _, true, true, _, true]) == [_, _, 7, 7, _, 9]
}
