module conformance.rejections part formatting

/**
A brace that opens no place and closes none rejects at that brace.

:Rules: FMT-3
:Status: proposed
*/
const fn format_unmatched_brace() -> str {
    # expect-error(type, "format.syntax")
    return format("at {")
}

/**
A positional place with no argument left rejects at that place.

:Rules: FMT-3
:Status: proposed
*/
const fn format_missing_argument() -> str {
    # expect-error(type, "format.argument")
    return format("{} {}", 1)
}

/**
An argument that no place takes rejects at that argument.

:Rules: FMT-3
:Status: proposed
*/
const fn format_unused_argument() -> str {
    # expect-error(type, "format.unused")
    return format("at", 1)
}

/**
A floating-point specifier on an integer rejects at the specifier.

:Rules: FMT-3, FMT-4
:Status: proposed
*/
const fn format_wrong_specifier() -> str {
    # expect-error(type, "format.specifier")
    return format("{:.2f}", 1)
}

/**
A time directive on a date rejects at the specifier.

:Rules: FMT-4
:Status: proposed
*/
const fn format_date_with_time() -> str {
    # expect-error(type, "format.specifier")
    return format("{:%H}", @2026-11-22)
}

/**
A date directive on a time rejects at the specifier.

:Rules: FMT-4
:Status: proposed
*/
const fn format_time_with_date() -> str {
    # expect-error(type, "format.specifier")
    return format("{:%Y}", @09:30:00)
}

/**
The evaluation-time place rejects in value code.

:Rules: FMT-9
:Status: proposed
*/
const fn format_engine_time_in_value_code() -> str {
    # expect-error(type, "format.argument")
    return format("{engine_time}")
}

/**
A marked place with a plain value rejects at the mark.

:Rules: FMT-9
:Status: proposed
*/
const fn format_marks_unmarked_value() -> str {
    # expect-error(type, "format.specifier")
    return format("{*}", 1)
}
