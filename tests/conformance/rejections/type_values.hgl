module conformance.rejections part type_values

struct DeltaTypeDescriptor { kind: Type }
struct DeltaTypeBox<T> { value: T }

/**
A Type value holds a Type and has no delta under the proposed Type-containing rule.

Rules:
    TYPE-16, TYPE-18

Status:
    proposed
*/
const fn reject_type_delta(
    # expect-error(shape, "delta.unsupported_shape")
    value: delta<Type>
) {}

/**
A DeltaTypeDescriptor value holds a Type and has no delta under the proposed Type-containing rule.

Rules:
    TYPE-16, TYPE-18

Status:
    proposed
*/
const fn reject_struct_delta(
    # expect-error(shape, "delta.unsupported_shape")
    value: delta<DeltaTypeDescriptor>
) {}

