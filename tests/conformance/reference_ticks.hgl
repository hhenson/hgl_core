module conformance part reference_ticks

fn selected_price(key: str, changed_key: str, price: i64?) -> i64 =>
    write_price(changed_key, price)[key]

/**
Switching a live key selection samples the new child and follows its publications.
Both prices exist before the switch. The proposed selection behavior makes
the later A-only change silent after the reader switches to B.

:Rules: TYPE-9, TYPE-16, EXPR-7, TIME-10
:Status: proposed
*/
test switching_keys_follows_the_new_child {
    assert eval(selected_price(
        key:         ["A",   _, "B",   _,   _],
        changed_key: ["A", "B",   _, "A", "B"],
        price:       [  7,  20,   _,   8,  21],
    )) ==            [  7,   _,  20,   _,  21]
}

fn pick_reference(flag: bool, low: ref<i64>, high: ref<i64>) -> ref<i64> {
    when modified(flag) {
        if flag { return high }
        return low
    }
}

fn count_designations(target: ref<i64>) -> i64 {
    state count: i64 = 0
    when {
        count += 1
        return count
    }
}

fn designation_changes(flag: bool, low: i64, high: i64) -> i64 =>
    count_designations(pick_reference(flag, low, high))

/**
A reference published again with the same designation does not tick its reader.
Each `ref<i64>` input is given a connection of `i64`. The flag picks the
high input twice, then the low one: the reader counts two designations.
A later tick of the low input, its target, does not wake it.

:Rules: TIME-10, TYPE-12, END-10
:Status: agreed
*/
test a_reference_published_again_does_not_tick_its_reader {
    assert eval(designation_changes(
        flag: [true, true, false, _],
        low:  [   1,    _,     _, 4],
        high: [   2,    _,     _, _],
    )) ==     [   1,    _,     2]
}

fn sample_selection(use_left: bool, left: i64, right: i64, probe: bool) -> i64 {
    let selected = if use_left { left } else { right }
    return sample_on_probe(selected, probe)
}

/**
A selected connection supplies its retained value when sampled later.
Neither producer ticks during either switch. A probe observes the right
producer's 20 and, after switching back, the left producer's newer 9.

:Rules: TIME-1, TIME-3, CTRL-2, CTRL-13
:Status: agreed
*/
test a_probe_reads_a_selected_producer_that_stayed_quiet {
    assert eval(sample_selection(
        use_left: [true, false,    _, _, true,    _],
        left:     [   7,     _,    _, 9,    _,    _],
        right:    [  20,     _,    _, _,    _,    _],
        probe:    [true,     _, true, _,    _, true],
    )) ==         [   7,     _,   20, _,    _,    9]
}
