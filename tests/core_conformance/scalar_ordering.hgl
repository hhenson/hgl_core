module core_conformance part scalar_ordering

/**
Bytes compare lexicographically by unsigned octets.
Equal prefixes compare by length.

Rules:
    TYPE-1, OPS-2, OPS-3

Status:
    agreed
*/
test bytes_use_unsigned_octet_order {
    let low = convert<bytes>("\u{7f}")
    let high = convert<bytes>("\u{80}")
    assert low < high && high > low
    assert low <= high && high >= low
    assert low <= low && high >= high
    assert !(high < low) && !(low > high)
    assert (low <=> high) == .less
    assert (high <=> high) == .equivalent
    assert compare_(high, low) == .greater
    let prefix = convert<bytes>("p")
    assert (prefix <=> convert<bytes>("p\u{80}")) == .less
    assert convert<bytes>("p\u{7f}z") < convert<bytes>("p\u{80}")
}

/**
Text follows code point order, false comes before true, and durations
compare by signed length.

Rules:
    TYPE-1, TYPE-2, OPS-2

Status:
    agreed
*/
test text_boolean_and_duration_order {
    assert "B" < "a"
    assert "\u{7f}" < "\u{80}"
    assert false < true
    assert -5m < 0s
}

struct Version {
    major: i64
    minor: i64
}

impl const fn compare_(lhs: Version, rhs: Version) -> CmpResult {
    if lhs.major != rhs.major { return lhs.major <=> rhs.major }
    return lhs.minor <=> rhs.minor
}

struct Grade {
    label: str
    rank: i64
}

impl const fn compare_(lhs: Grade, rhs: Grade) -> CmpResult => lhs.rank <=> rhs.rank

/**
A type that declares `<=>` alone has the six Boolean comparisons.
Equality reads the declared outcome, not the fields.

Rules:
    OPS-12, OPS-3

Status:
    agreed
*/
test full_comparison_gives_the_boolean_comparisons {
    let old = Version(major: 1, minor: 9)
    let new = Version(major: 2, minor: 0)
    assert old < new && old <= new && new > old && new >= old
    assert !(new < old) && !(old > new)
    assert old == old && old != new && !(old == new)
    assert old <= old && old >= old
    let pass = Grade(label: "pass", rank: 1)
    let merit = Grade(label: "merit", rank: 1)
    assert pass == merit && !(pass != merit)
}

/**
An unordered outcome makes every Boolean comparison but `!=` false.

Rules:
    OPS-12, NUM-5, NUM-6

Status:
    agreed
*/
test unordered_outcome_is_only_unequal {
    let nan: f64 = 0.0 /{zero: .nan} 0.0
    assert (nan <=> 1.0) == .unordered
    assert !(nan < 1.0) && !(nan <= 1.0) && !(nan > 1.0) && !(nan >= 1.0)
    assert !(nan == nan) && nan != nan
    assert !(1M < 1B) && !(1M >= 1B) && 1M != 1B
}

/**
Proposed: the remainder of two durations is what floor division leaves.

Rules:
    OPS-13, NUM-12

Status:
    proposed
*/
test duration_remainder_follows_floor_division {
    assert 7m % 3m == 1m
    assert -7m % 3m == 2m
    assert 7m % -3m == -2m
    assert (7m // 3m) * 3m + 7m % 3m == 7m
    assert raises("numeric.division_by_zero") { 7m % 0s }
    let checked: result<duration, error> = 7m %{zero: .error} 0s
    assert is_err(checked)
}
